NODE_ENV=development
PORT=8000
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MongoDB is the only application database.
MONGODB_URI=
MONGODB_DATABASE=lummina
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Use a long random value in production.
SESSION_SECRET=
SESSION_COOKIE=lummina-session
SESSION_LIFETIME_MINUTES=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
TRUST_PROXY=false

RATE_LIMIT_PUBLIC=60
RATE_LIMIT_LOGIN=5

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lummina

# Resend is used by the admin Newsletter sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

LUMMINA_ADMIN_EMAIL=
LUMMINA_ADMIN_PASSWORD=
LUMMINA_ADMIN_FIRST_NAME=Faith
LUMMINA_ADMIN_LAST_NAME=Zekeri
